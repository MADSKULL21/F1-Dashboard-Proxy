# Base URL of the Spring Boot API, including the /api prefix.
#
# Local:      http://localhost:8080/api
# Production: set in the Vercel project settings to the Render service URL,
#             e.g. https://f1-dashboard-api.onrender.com/api
#
# Anything here is bundled into the client at build time, so it must never hold
# a secret.
VITE_API_BASE_URL=http://localhost:8080/api
